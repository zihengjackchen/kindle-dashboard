BIND_ADDRESS=0.0.0.0
DASHBOARD_TIMEZONE=America/Los_Angeles
API_TOKEN=
# NAS-side optional collectors; Kindle still refreshes manually.
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
WEATHER_LOCATION=
WEATHER_UNIT=F
# Finnhub takes precedence when configured. Never commit provider credentials.
FINNHUB_API_KEY=
FINNHUB_SP500_SYMBOL=^GSPC
# Comma-separated supported equity symbols; blank uses the original watchlist.
MARKET_SYMBOLS=
TWELVE_DATA_API_KEY=
TWELVE_DATA_SP500_SYMBOL=SPX
MARKET_DATA_DELAYED=1
CRYPTO_ENABLED=0
COLLECT_INTERVAL_SECONDS=3600
# Optional sanitized Markdown digest export (see docs/stock-reports.md).
# Enable Stock update report in the editor after configuring the directory.
DASHBOARD_REPORT_DIRECTORY=
